rules_version = '2';
// All Firestore access is handled exclusively via the Firebase Admin SDK
// on the FastAPI backend. The Admin SDK bypasses Security Rules entirely,
// so we lock down client-side access completely for defense-in-depth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
