{
  "name": "brickify",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i frontend/vendor/tailwind.input.css -o frontend/vendor/tailwind.css --minify",
    "watch:css": "tailwindcss -i frontend/vendor/tailwind.input.css -o frontend/vendor/tailwind.css --watch",
    "build:js": "esbuild frontend/app.js frontend/auth.js --minify --outdir=frontend --out-extension:.js=.min.js",
    "watch:js": "esbuild frontend/app.js frontend/auth.js --minify --watch --outdir=frontend --out-extension:.js=.min.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "esbuild": "^0.28.0",
    "tailwindcss": "^3.4.19"
  }
}
